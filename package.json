{
  "name": "exam-results",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "npm run lint && npm run test:unit",
    "prepare": "simple-git-hooks",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "import": "node --env-file-if-exists=.env src/db/import.js",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:unit": "vitest run tests/unit",
    "dev:api": "sh -c 'set -a && . ./.env && CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=\"$DATABASE_URL\" wrangler dev'",
    "prepublish:worker": "rm -f dist/.DS_Store dist/CNAME",
    "deploy": "npm run build && npm run prepublish:worker && wrangler deploy",
    "deploy:preprod": "npm run build && npm run prepublish:worker && wrangler deploy --env preprod"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "highlight.js": "^11.11.1",
    "pg": "^8.23.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.141.0"
  },
  "simple-git-hooks": {
    "pre-push": "npm run check"
  }
}
