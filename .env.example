# Copy to .env, then: docker compose up -d db
# .env is gitignored — never commit real credentials.

POSTGRES_USER=chu
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=chu_grades

# Host port the container is published on (loopback only).
# Change it if another PostgreSQL already listens on 5432,
# and keep DATABASE_URL below in sync.
DB_PORT=5432

# The only variable the application code reads.
DATABASE_URL=postgres://chu:local-dev-password@127.0.0.1:5432/chu_grades

# Password of the metabase_reader role, created by `npm run metabase:setup`.
# That role can only read the grades database; it owns the metabase_app
# database, where Metabase stores its own dashboards and accounts.
# Only needed by the optional local analytics profile — see the README.
METABASE_READER_PASSWORD=local-metabase-password
