# Copy to .env, then: docker compose up -d db
# .env is gitignored — never commit real credentials.

POSTGRES_USER=chu
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=chu_grades

# Host port the container is published on (loopback only).
# Change it if another PostgreSQL already listens on 5432,
# and keep DATABASE_URL below in sync.
DB_PORT=5432

# The only variable the application code reads.
DATABASE_URL=postgres://chu:local-dev-password@127.0.0.1:5432/chu_grades

# The production database, read by nothing implicitly: every command that
# touches it says so on the command line. Use Neon's DIRECT connection string,
# not the pooler's — migrations take a session-level advisory lock, and a
# transaction-mode pooler can serve the lock, the migration and the unlock on
# three different backends.
#
# A shell does not read this file, so load it before expanding the variable:
#   set -a && . ./.env && set +a
#   DATABASE_URL="$NEON_DATABASE_URL" npm run migrate
# Without that first line the expansion yields "", which is *set* and therefore
# hides DATABASE_URL above instead of falling back to it.
NEON_DATABASE_URL=
